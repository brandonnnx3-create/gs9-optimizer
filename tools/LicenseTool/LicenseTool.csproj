<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LicenseTool</AssemblyName>
    <RootNamespace>ConnectionOptimizer.LicenseTool</RootNamespace>
  </PropertyGroup>

  <!-- Same allowlist format and hardware-ID rules as the app. -->
  <ItemGroup>
    <Compile Include="..\..\src\ConnectionOptimizer\Services\Licensing\Allowlist.cs" Link="Shared\Allowlist.cs" />
    <Compile Include="..\..\src\ConnectionOptimizer\Services\Licensing\LicenseFormat.cs" Link="Shared\LicenseFormat.cs" />
    <Compile Include="..\..\src\ConnectionOptimizer\Services\Licensing\HardwareIdCode.cs" Link="Shared\HardwareIdCode.cs" />
  </ItemGroup>

</Project>
