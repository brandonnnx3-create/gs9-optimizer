<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScriptPacker</AssemblyName>
    <RootNamespace>ConnectionOptimizer.ScriptPacker</RootNamespace>
  </PropertyGroup>

  <!-- Same archive format the app uses to unpack. -->
  <ItemGroup>
    <Compile Include="..\..\src\ConnectionOptimizer\Services\Scripts\ScriptArchive.cs" Link="Shared\ScriptArchive.cs" />
  </ItemGroup>

</Project>
