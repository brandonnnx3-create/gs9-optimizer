<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- G.S.9 design tokens. Every color, font and size in the UI comes from here.
         Rules and usage: docs/DESIGN_SYSTEM.md -->

    <!-- COLOR: black and white. Grays only for secondary information. -->
    <Color x:Key="Color.Background">#050505</Color>
    <Color x:Key="Color.Raised">#0E0E0E</Color>
    <Color x:Key="Color.Line">#242424</Color>
    <Color x:Key="Color.LineStrong">#3A3A3A</Color>
    <Color x:Key="Color.Text">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#A0A0A0</Color>
    <Color x:Key="Color.TextMuted">#6E6E6E</Color>
    <Color x:Key="Color.PrimaryHover">#E2E2E2</Color>
    <Color x:Key="Color.PrimaryPressed">#C4C4C4</Color>
    <!-- State accents. Never the only signal: every state also has its own glyph and word. -->
    <Color x:Key="Color.Ok">#00FF88</Color>
    <Color x:Key="Color.Error">#FF3B3B</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Raised" Color="{StaticResource Color.Raised}"/>
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}"/>
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>

    <!-- TYPE: heavy display face for brand, titles and states; clean sans for text; mono for technical values. -->
    <FontFamily x:Key="Font.Display">Arial Black, Segoe UI Black</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Symbol">Segoe UI Symbol</FontFamily>

    <sys:Double x:Key="Type.Hero">60</sys:Double>
    <sys:Double x:Key="Type.Display">30</sys:Double>
    <sys:Double x:Key="Type.Figure">20</sys:Double>
    <sys:Double x:Key="Type.Title">19</sys:Double>
    <sys:Double x:Key="Type.Section">13</sys:Double>
    <sys:Double x:Key="Type.Body">13</sys:Double>
    <sys:Double x:Key="Type.Mono">12</sys:Double>
    <sys:Double x:Key="Type.Label">11</sys:Double>

    <!-- SPACE: 4 / 8 / 12 / 16 / 24 / 32 / 40 -->
    <Thickness x:Key="Space.Cell">24,20,24,22</Thickness>
    <Thickness x:Key="Space.TableCell">20,14,20,16</Thickness>

</ResourceDictionary>
