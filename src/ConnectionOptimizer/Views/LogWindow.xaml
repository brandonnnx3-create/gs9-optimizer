<Window x:Class="ConnectionOptimizer.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:ConnectionOptimizer.Views.Markup"
        Title="{Binding WindowTitle}"
        Width="980" Height="660"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource Type.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- DataContext: LogView -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
            <StackPanel Margin="32,24,32,20">
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label, Converter={StaticResource Tracking}}"/>
                <TextBlock Style="{StaticResource Text.Display}" FontSize="26" Margin="0,8,0,0" Text="{Binding Title}"/>

                <Border Margin="0,18,0,0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,1,0,1">
                    <UniformGrid Rows="1" Columns="4">
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="16,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked SCRIPT}"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Script}" ToolTip="{Binding Script}"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="16,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked STARTED}"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" Text="{Binding Started}"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="16,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked DURATION}"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" Text="{Binding Duration}"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="16,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked RESULT}"/>
                                <TextBlock x:Name="ResultText" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}"
                                           Margin="0,6,0,0" Text="{Binding Result}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <TextBlock Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,0"
                           TextTrimming="CharacterEllipsis" Text="{Binding LogFile}" ToolTip="{Binding LogFile}"/>
            </StackPanel>
        </Border>

        <TextBox Grid.Row="1" Style="{StaticResource LogTextBox}" Text="{Binding Output, Mode=OneWay}"/>

        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="32,14,32,16">
                <Button x:Name="OpenFolderButton" Style="{StaticResource Button.Secondary}" Height="44"
                        Content="{m:Tracked 'SHOW LOG FILE'}" Click="OnShowLogFile"/>
                <Button Style="{StaticResource Button.PrimaryCompact}" Margin="10,0,0,0" IsCancel="True"
                        Content="CLOSE" Click="OnClose"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
