<Window x:Class="ConnectionOptimizer.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:ConnectionOptimizer.Views.Markup"
        Title="G.S.9 — Connection Optimizer"
        Width="720"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource Type.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <StackPanel>
        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
            <StackPanel Margin="40,32,40,28">
                <TextBlock Style="{StaticResource Text.Hero}" Text="G.S.9"/>
                <TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Text}" FontSize="12"
                           Margin="2,12,0,0" Text="{m:Tracked 'CONNECTION OPTIMIZER'}"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="40,28,40,36">
            <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked 'PRIVATE ACCESS'}"/>
            <TextBlock x:Name="HeadlineText" Style="{StaticResource Text.Display}" FontSize="28" Margin="0,10,0,0"
                       TextWrapping="Wrap" Text="CHECKING ACCESS…"/>

            <TextBlock Style="{StaticResource Text.Label}" Margin="0,28,0,0" Text="{m:Tracked 'HARDWARE ID'}"/>
            <Border Margin="0,10,0,0" BorderBrush="{StaticResource Brush.Text}" BorderThickness="1">
                <DockPanel Margin="20,14,16,14">
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                            VerticalAlignment="Center" Content="{m:Tracked COPY}" Click="OnCopy"/>
                    <TextBlock x:Name="HwidText" FontFamily="{StaticResource Font.Mono}" FontSize="26"
                               VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" Text="…"/>
                </DockPanel>
            </Border>

            <StackPanel x:Name="MessagePanel" Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock x:Name="MessageGlyph" FontFamily="{StaticResource Font.Symbol}" FontSize="13"
                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,10,0" Text="›"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" MaxWidth="600"
                           Text="Send this hardware ID to G.S.9 to be authorized."/>
            </StackPanel>

            <Button x:Name="RetryButton" Style="{StaticResource Button.Primary}" Height="64" FontSize="18"
                    Margin="0,28,0,0" Click="OnRetry">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Font.Text}" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" Text="{m:Tracked '↻'}"/>
                    <TextBlock x:Name="RetryText" VerticalAlignment="Center" Text="RE-CHECK ACCESS"/>
                </DockPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
