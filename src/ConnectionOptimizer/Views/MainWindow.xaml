<Window x:Class="ConnectionOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ConnectionOptimizer.Views"
        xmlns:m="clr-namespace:ConnectionOptimizer.Views.Markup"
        Title="G.S.9 — Connection Optimizer"
        Width="1440" Height="960"
        MinWidth="1180" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource Type.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER: brand · system status · privileges ═══ -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
            <Grid Margin="40,28,40,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Text.Hero}" Text="G.S.9"/>
                    <TextBlock Style="{StaticResource Text.Label}"
                               Foreground="{StaticResource Brush.Text}"
                               FontSize="12"
                               Margin="2,12,0,0"
                               Text="{m:Tracked 'CONNECTION OPTIMIZER'}"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,0,0,0" Padding="28,0,40,0">
                    <StackPanel VerticalAlignment="Bottom" Width="400">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked 'SYSTEM STATUS'}"/>
                        <v:StatusBadge Margin="0,10,0,0"
                                       FontSize="{StaticResource Type.Display}"
                                       Kind="{Binding SystemStatusKind}"
                                       Text="{Binding SystemStatusText}"/>
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" Text="{Binding SystemDetail}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,0,0,0" Padding="28,0,0,0">
                    <StackPanel VerticalAlignment="Bottom" Width="200">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked PRIVILEGES}"/>
                        <TextBlock Style="{StaticResource Text.Section}" FontSize="16" Margin="0,12,0,0" Text="{Binding PrivilegesText}"/>
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,6,0,0" Text="{Binding PrivilegesDetail}"/>
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Content="{m:Tracked 'RUN AS ADMIN →'}"
                                Command="{Binding ElevateCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource Visibility}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ CONNECTION: technical readout of the active adapter ═══ -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
            <StackPanel Margin="40,20,40,24">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Button.Ghost}"
                            Content="{m:Tracked 'REFRESH'}"
                            Command="{Binding RefreshConnectionCommand}"/>
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource Text.Mono}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"
                               Text="{Binding Connection.UpdatedText}"/>
                    <TextBlock Style="{StaticResource Text.Section}" Text="{m:Tracked CONNECTION}"/>
                </DockPanel>

                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Rows="1" Columns="5">
                            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="{StaticResource Space.TableCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked TYPE}"/>
                                    <TextBlock Style="{StaticResource Text.Figure}" Margin="0,8,0,0" Text="{Binding Connection.Medium}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="{StaticResource Space.TableCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked 'LINK SPEED'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Text.Figure}" Text="{Binding Connection.SpeedValue}"/>
                                        <TextBlock Style="{StaticResource Text.Label}"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="8,0,0,3"
                                                   Text="{Binding Connection.SpeedUnit, Converter={StaticResource Tracking}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="{StaticResource Space.TableCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked STATUS}"/>
                                    <v:StatusBadge Margin="0,8,0,0"
                                                   FontSize="{StaticResource Type.Figure}"
                                                   Kind="{Binding Connection.StatusKind}"
                                                   Text="{Binding Connection.StatusText}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="{StaticResource Space.TableCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked IPv4}"/>
                                    <TextBlock Style="{StaticResource Text.MonoValue}" Margin="0,10,0,0" Text="{Binding Connection.IPv4}" ToolTip="{Binding Connection.IPv4}"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="{StaticResource Space.TableCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked GATEWAY}"/>
                                    <TextBlock Style="{StaticResource Text.MonoValue}" Margin="0,10,0,0" Text="{Binding Connection.Gateway}" ToolTip="{Binding Connection.Gateway}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,12,20,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{m:Tracked ADAPTER}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Value}" VerticalAlignment="Center" Margin="0,0,24,0"
                                           ToolTip="{Binding Connection.AdapterDescription}">
                                    <Run Text="{Binding Connection.AdapterDescription, Mode=OneWay}"/>
                                    <Run Text="  ·  " Foreground="{StaticResource Brush.TextMuted}"/>
                                    <Run Text="{Binding Connection.AdapterName, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{m:Tracked DNS}"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,24,0"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Connection.Dns}" ToolTip="{Binding Connection.Dns}"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{m:Tracked INTERFACE}"/>
                                <TextBlock Grid.Column="5" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Connection.InterfaceGuid}" ToolTip="{Binding Connection.InterfaceGuid}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ ALERT: shown when an optimization fails ═══ -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource Brush.Error}"
                BorderThickness="4,0,0,0"
                Visibility="{Binding Alert, Converter={StaticResource Visibility}}">
            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="36,16,40,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="{m:Tracked DISMISS}"
                                Command="{Binding DismissAlertCommand}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Symbol}" FontSize="14" Foreground="{StaticResource Brush.Error}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Text="✕"/>
                            <TextBlock Style="{StaticResource Text.Section}" FontSize="15" Foreground="{StaticResource Brush.Error}"
                                       VerticalAlignment="Center" Text="{Binding Alert.Title}"/>
                            <TextBlock Style="{StaticResource Text.Section}" FontSize="15" VerticalAlignment="Center"
                                       Margin="16,0,0,0" Text="{Binding Alert.Subject}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" Text="{Binding Alert.Message}"/>
                        <TextBlock Style="{StaticResource Text.Mono}" Margin="0,4,0,0" Text="{Binding Alert.Detail}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══ BODY: tools | activity ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="40,24,40,8">

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Mono}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                                       Text="{Binding NetworkCount}"/>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{m:Tracked NETWORK}"/>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,1,0,0">
                            <ItemsControl ItemsSource="{Binding NetworkModules}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Cell}" BorderThickness="0,0,1,1">
                                            <v:OptimizationCell/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <DockPanel Margin="0,28,0,12">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Mono}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                                       Text="{Binding CleanupCount}"/>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{m:Tracked CLEANUP}"/>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,1,0,0">
                            <ItemsControl ItemsSource="{Binding CleanupModules}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Cell}" BorderThickness="0,0,1,1">
                                            <v:OptimizationCell/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Main call to action, always visible under the tools. -->
                <StackPanel Grid.Row="1" Margin="40,16,40,28">

                    <!-- Sequence progress: one segment per script. -->
                    <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,1,0,0"
                            Visibility="{Binding IsBatchVisible, Converter={StaticResource Visibility}}">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="20,12,20,12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Section}" FontSize="15" Text="{Binding BatchCounter}"/>
                                    <TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                                               Text="{Binding BatchHeadline, Converter={StaticResource Tracking}}"/>
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding BatchSteps}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,1,0">
                                            <StackPanel>
                                                <Rectangle x:Name="Bar" Height="3" Fill="{StaticResource Brush.Line}"/>
                                                <StackPanel Margin="16,10,16,12">
                                                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="11"
                                                               Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Number}"/>
                                                    <TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Text}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                                    <TextBlock x:Name="StateText" Style="{StaticResource Text.Mono}" FontSize="11"
                                                               Margin="0,3,0,0" Text="{Binding StateText}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter TargetName="Bar" Property="Fill" Value="{StaticResource Brush.Text}"/>
                                                <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseBar">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.25" Duration="0:0:0.7"
                                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseBar"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Done">
                                                <Setter TargetName="Bar" Property="Fill" Value="{StaticResource Brush.Ok}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter TargetName="Bar" Property="Fill" Value="{StaticResource Brush.Error}"/>
                                                <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Height="72">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding ActivateAllCommand}"
                                Visibility="{Binding IsBatchRunning, Converter={StaticResource Visibility}, ConverterParameter=invert}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           FontFamily="{StaticResource Font.Text}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding ActivateAllHint, Converter={StaticResource Tracking}}"/>
                                <TextBlock VerticalAlignment="Center" Text="ACTIVATE ALL"/>
                            </DockPanel>
                        </Button>

                        <Border BorderBrush="{StaticResource Brush.Text}" BorderThickness="1"
                                Visibility="{Binding IsBatchRunning, Converter={StaticResource Visibility}}">
                            <DockPanel Margin="28,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Display}" FontSize="26"
                                           VerticalAlignment="Center" Text="{Binding BatchCounter}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Section}" FontSize="18" Text="APPLYING OPTIMIZATIONS…"/>
                                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,4,0,0" Text="{Binding BatchCurrent}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ACTIVITY -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1,0,0,0">
                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Text.Section}" Margin="0,0,0,16" Text="{m:Tracked ACTIVITY}"/>

                    <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,1">
                        <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Activity.Entries}" Margin="0,12,8,4" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,1,0,0" Text="{Binding Time}"/>
                                            <TextBlock x:Name="Glyph" Grid.Column="1" FontFamily="{StaticResource Font.Symbol}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,1,0,0" Text="{Binding Glyph}"/>
                                            <TextBlock x:Name="Message" Grid.Column="2" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Text}" Text="{Binding Message}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Ok}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                                <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="4" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
            <TextBlock Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                       Margin="40,9,40,10" TextTrimming="CharacterEllipsis" Text="{Binding FooterText}" ToolTip="{Binding FooterText}"/>
        </Border>
    </Grid>
</Window>
