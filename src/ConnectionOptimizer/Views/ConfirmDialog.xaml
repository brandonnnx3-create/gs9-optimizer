<Window x:Class="ConnectionOptimizer.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:ConnectionOptimizer.Views.Markup"
        Title="G.S.9"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource Type.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- DataContext: ConfirmRequest -->
    <StackPanel Margin="36,30,36,30">
        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label, Converter={StaticResource Tracking}}"/>
        <TextBlock Style="{StaticResource Text.Display}" FontSize="26" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Title}"/>
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0" Text="{Binding Message}"/>

        <Border Margin="0,20,0,0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasItems, Converter={StaticResource Visibility}}">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,9">
                            <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}" Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Margin="0,22,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource Visibility}}">
            <TextBlock Style="{StaticResource Text.Label}" Text="{m:Tracked 'WHAT WILL HAPPEN'}"/>
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Warnings}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Left" Width="22" Foreground="{StaticResource Brush.TextMuted}" Text="—"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" Text="{Binding}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Margin="0,18,0,0" BorderBrush="{StaticResource Brush.Text}" BorderThickness="1" Padding="16,12"
                Visibility="{Binding Note, Converter={StaticResource Visibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Text}"
                           Text="{Binding NoteTitle, Converter={StaticResource Tracking}}"/>
                <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" Text="{Binding Note}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Style="{StaticResource Button.Secondary}" Height="44" MinWidth="120" IsCancel="True"
                    Content="{Binding CancelText, Converter={StaticResource Tracking}}"/>
            <Button Style="{StaticResource Button.PrimaryCompact}" Margin="10,0,0,0" Click="OnConfirm">
                <TextBlock Text="{Binding ConfirmText}"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
