<UserControl x:Class="ConnectionOptimizer.Views.OptimizationCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ConnectionOptimizer.Views"
             xmlns:m="clr-namespace:ConnectionOptimizer.Views.Markup">
    <!-- One tool in the grid. DataContext: OptimizationViewModel. -->
    <Grid Margin="{StaticResource Space.Cell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="26"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 01  NETWORK -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource Text.Mono}"
                       Foreground="{StaticResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       Text="{Binding Number}"/>
            <TextBlock Style="{StaticResource Text.Label}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Category, Converter={StaticResource Tracking}}"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource Text.Title}" Text="{Binding Name}"/>
        <TextBlock Grid.Row="2" Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{Binding Description}"/>

        <v:StatusBadge Grid.Row="4"
                       FontSize="22"
                       Kind="{Binding StatusKind}"
                       Text="{Binding StatusText}"/>

        <TextBlock Grid.Row="5"
                   Style="{StaticResource Text.Mono}"
                   Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusCaption}"
                   ToolTip="{Binding StatusCaption}"/>

        <TextBlock Grid.Row="6"
                   Style="{StaticResource Text.Mono}"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding Hint}"
                   Visibility="{Binding Hint, Converter={StaticResource Visibility}}"/>

        <WrapPanel Grid.Row="7" Margin="0,18,0,-8">
            <!-- Only while the script has a window open that may be waiting for the user. -->
            <Button Style="{StaticResource Button.Secondary}"
                    Margin="0,0,8,8"
                    Content="{m:Tracked 'SHOW WINDOW'}"
                    Command="{Binding ShowWindowCommand}"
                    Visibility="{Binding HasOpenWindow, Converter={StaticResource Visibility}}"/>
            <Button Style="{StaticResource Button.Secondary}"
                    Margin="0,0,8,8"
                    Content="{m:Tracked ACTIVATE}"
                    Command="{Binding ActivateCommand}"/>
            <Button Style="{StaticResource Button.Secondary}"
                    Margin="0,0,0,8"
                    Content="{m:Tracked 'CHECK STATUS'}"
                    Command="{Binding CheckStatusCommand}"
                    Visibility="{Binding HasVerifier, Converter={StaticResource Visibility}}"/>
        </WrapPanel>
    </Grid>
</UserControl>
