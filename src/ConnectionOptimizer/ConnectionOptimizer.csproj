<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ConnectionOptimizer</AssemblyName>
    <RootNamespace>ConnectionOptimizer</RootNamespace>
    <Product>Connection Optimizer</Product>
    <Company>G.S.9</Company>
    <Version>1.4.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where the scripts, the secret key and the packed blob live during the build. -->
    <ScriptsSourceDir>$(MSBuildProjectDirectory)\..\..\scripts</ScriptsSourceDir>
    <ScriptKeyFile>$(MSBuildProjectDirectory)\..\..\build\script-key.txt</ScriptKeyFile>
    <!-- Absolute and stable so the WPF markup-compile pass (which re-evaluates paths) cannot drop it in the project root. -->
    <PackedScriptsFile>$(MSBuildProjectDirectory)\obj\gen\ProtectedScripts.bin</PackedScriptsFile>
    <ScriptPackerProject>$(MSBuildProjectDirectory)\..\..\tools\ScriptPacker\ScriptPacker.csproj</ScriptPackerProject>
  </PropertyGroup>

  <!-- The scripts ship encrypted inside the executable (see Services/Scripts). There is no Scripts folder. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PackedScriptsFile)" LogicalName="ConnectionOptimizer.ProtectedScripts.bin" Visible="false" />
    <EmbeddedResource Include="$(ScriptKeyFile)" LogicalName="ConnectionOptimizer.ScriptKey.txt" Visible="false" />
  </ItemGroup>

  <!-- Encrypt the scripts before they are embedded. Reruns when a script or the packer changes. -->
  <Target Name="PackScripts"
          BeforeTargets="PrepareForBuild;BeforeCompile;CoreCompile"
          Inputs="$(ScriptsSourceDir)\*.bat;$(ScriptsSourceDir)\*.cmd;$(ScriptPackerProject);tools\ScriptPacker\Program.cs"
          Outputs="$(PackedScriptsFile)">
    <Exec Command="dotnet run --project &quot;$(ScriptPackerProject)&quot; -c Release --no-launch-profile -- &quot;$(ScriptsSourceDir)&quot; &quot;$(ScriptKeyFile)&quot; &quot;$(PackedScriptsFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
